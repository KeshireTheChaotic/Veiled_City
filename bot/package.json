{
  "name": "veiled-city-discord-gm",
  "version": "0.0.0.1",
  "private": true,
  "type": "module",
  "description": "Stateful multiplayer Discord GM bot for Veiled City / Daggerheart.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "architecture:check": "node tooling/architecture/check-boundaries.mjs --ratchet --phase RF02",
    "architecture:strict": "node tooling/architecture/check-boundaries.mjs --strict --phase RF02",
    "register": "node src/register-commands.js",
    "check": "node scripts/check-source.mjs && node scripts/validate-command-schema.mjs",
    "export": "node scripts/export-campaign.mjs",
    "cost": "node scripts/cost-estimate.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "quality": "node scripts/quality-check.mjs",
    "validate": "node scripts/validate-offline.mjs",
    "validate:extended": "node scripts/validate-offline.mjs --extended",
    "test:refactor": "node scripts/refactor-regression-test.mjs",
    "lint": "npm run quality",
    "format:check": "node scripts/format-check.mjs",
    "test:audit": "node scripts/audit-regression-test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "openai": "6.6.0",
    "@discordjs/voice": "0.19.2",
    "opusscript": "0.1.1",
    "libsodium-wrappers": "0.8.4"
  },
  "overrides": {
    "undici": "6.29.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "acorn": "8.15.0"
  }
}
