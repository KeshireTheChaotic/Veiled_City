{
  "name": "veiled-city-discord-gm",
  "version": "6.2.0",
  "private": true,
  "type": "module",
  "description": "Stateful multiplayer Discord GM bot for Veiled City / Daggerheart.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/register-commands.js",
    "check": "node scripts/check-source.mjs && node scripts/validate-command-schema.mjs",
    "export": "node scripts/export-campaign.mjs",
    "cost": "node scripts/cost-estimate.mjs",
    "test:offline": "node scripts/offline-smoke-test.mjs",
    "test:quality-fixtures": "node --import ./scripts/offline-guard.mjs scripts/expansion-quality-test.mjs",
    "test:production": "node scripts/production-regression-test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "quality": "node scripts/quality-check.mjs",
    "validate": "node scripts/validate-offline.mjs",
    "test:contract": "node --import ./scripts/offline-guard.mjs scripts/narrative-contract-test.mjs",
    "test:context": "node --import ./scripts/offline-guard.mjs scripts/context-conversation-test.mjs",
    "test:continuity": "node --import ./scripts/offline-guard.mjs scripts/story-continuity-test.mjs",
    "test:negotiation": "node --import ./scripts/offline-guard.mjs scripts/negotiation-preview-test.mjs",
    "test:endurance": "node --import ./scripts/offline-guard.mjs scripts/endurance-test.mjs",
    "test:authoring": "node --import ./scripts/offline-guard.mjs scripts/portrayal-authoring-test.mjs",
    "test:refactor": "node scripts/refactor-regression-test.mjs",
    "lint": "npm run quality",
    "format:check": "node scripts/format-check.mjs",
    "test:operations": "node scripts/operations-regression-test.mjs",
    "test:cognition": "node scripts/npc-cognition-regression-test.mjs",
    "test:audit": "node scripts/audit-regression-test.mjs",
    "test:simulation": "node scripts/simulation-regression-test.mjs",
    "test:seed": "node --import ./scripts/offline-guard.mjs scripts/seed-data-regression-test.mjs && node --import ./scripts/offline-guard.mjs scripts/seed-drafts-regression-test.mjs",
    "test:city": "node scripts/city-regression-test.mjs && node scripts/city-core-regression-test.mjs && node scripts/city-civic-regression-test.mjs && node scripts/city-depth-regression-test.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "openai": "6.6.0",
    "@discordjs/voice": "0.19.2",
    "opusscript": "0.1.1",
    "libsodium-wrappers": "0.8.4"
  },
  "overrides": {
    "undici": "6.29.0",
    "ws": "8.22.0"
  }
}
