{
  "name": "veiled-city-discord-gm",
  "version": "3.7.0",
  "private": true,
  "type": "module",
  "description": "Stateful multiplayer Discord GM bot for Veiled City / Daggerheart.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/register-commands.js",
    "check": "node scripts/check-source.mjs && node scripts/validate-command-schema.mjs",
    "export": "node scripts/export-campaign.mjs",
    "cost": "node scripts/cost-estimate.mjs",
    "test:offline": "node scripts/offline-smoke-test.mjs",
    "test:production": "node scripts/production-regression-test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "quality": "node scripts/quality-check.mjs",
    "validate": "npm run lint && npm run format:check && npm run check && npm run test:offline && npm run test:production && npm run test:refactor && npm run test:operations",
    "test:refactor": "node scripts/refactor-regression-test.mjs",
    "lint": "npm run quality",
    "format:check": "node scripts/format-check.mjs",
    "test:operations": "node scripts/operations-regression-test.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "openai": "6.6.0",
    "@discordjs/voice": "0.19.2",
    "opusscript": "0.1.1",
    "libsodium-wrappers": "0.8.4"
  },
  "overrides": {
    "undici": "6.29.0",
    "ws": "8.22.0"
  }
}
