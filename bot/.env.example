# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Recommended while testing: register commands to one server instantly.
DISCORD_GUILD_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_GM_MODEL=gpt-6.1-sol
OPENAI_ROUTER_MODEL=gpt-6-luna
OPENAI_SUMMARY_MODEL=gpt-6-luna
# v3.1: cheap, low-effort rules assistant. Defaults to ROUTER_MODEL when omitted.
OPENAI_RULES_MODEL=gpt-6-luna
# v3.1.1: low-cost convergence/arrival planning; defaults to ROUTER_MODEL.
OPENAI_ASSEMBLY_MODEL=gpt-6-luna
# v3.1.2: sanitized guest-NPC proxy packet generation; defaults to ASSEMBLY/ROUTER model.
OPENAI_NPC_PROXY_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
RULES_MAX_OUTPUT_TOKENS=500
ASSEMBLY_MAX_OUTPUT_TOKENS=1200
NPC_PROXY_MAX_OUTPUT_TOKENS=1200

# Local state/content
DATABASE_PATH=./data/veiled_city.sqlite
CONTENT_ROOT=../content

# Runtime
LOG_LEVEL=info
MAX_RECENT_MESSAGES=28
MAX_CONTENT_CHUNKS=8
MAX_RULES_CHUNKS=6
# active = lightweight router considers every #the-table message
# assisted = mention or probable character action only
# mention = only @Veilkeeper / explicit slash commands
DEFAULT_RESPONSE_MODE=assisted

STRUCTURED_JSON_RETRY_MAX_TOKENS=6000
OPENAI_DOWNTIME_MODEL=gpt-6.1-sol
DOWNTIME_MAX_OUTPUT_TOKENS=1800

# v3.3.0 evidence/aftermath generation. Both default to inexpensive models.
OPENAI_HANDOUT_MODEL=gpt-6-luna
HANDOUT_MAX_OUTPUT_TOKENS=1200
OPENAI_AFTERMATH_MODEL=gpt-6-luna
AFTERMATH_MAX_OUTPUT_TOKENS=1800
# auto = apply aftermath consequences immediately; confirm = require /vc-encounter aftermath-confirm; none = skip generation
ENCOUNTER_AFTERMATH_MODE=auto

# v3.4.1 Discord voice narration (optional)
# Requires FFmpeg in PATH and bot permissions: Connect + Speak in the target voice channel.
VOICE_ENABLED=false
# OpenAI Text-to-Speech API model. gpt-4o-mini-tts supports delivery instructions.
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
# off | narrative | full. Runtime can also be changed with /vc-voice configure.
VOICE_MODE=narrative
# Built-in: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse, marin, cedar
# Or set this to an approved custom OpenAI voice ID such as voice_123abc.
VOICE_NAME=cedar
# Optional alias if you prefer to keep the custom ID separate; VOICE_NAME takes precedence.
VOICE_CUSTOM_ID=
VOICE_INSTRUCTIONS=Low-key occult noir narrator. Measured pace, restrained emotion, clear diction, cinematic but never melodramatic.
VOICE_SPEED=1.0
# Safety/cost caps per Veilkeeper narration turn and pending audio queue.
VOICE_MAX_CHARS_PER_TURN=12000
VOICE_MAX_QUEUE=8
# Per-user cooldown for /vc-voice repeat. Repeat never makes a new TTS API request.
VOICE_REPEAT_COOLDOWN_SECONDS=8
